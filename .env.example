# PHC-SHIELD Environment Variables
# Copy this file to .env and configure your variables

# Google Gemini AI Integration (Backend Only)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
# Local SQLite default: sqlite:///./phc_shield.db
# Cloud Run / PostgreSQL: postgresql://user:password@localhost:5432/phc_shield_db
DATABASE_URL=sqlite:///./phc_shield.db

# Environment (development / production)
ENVIRONMENT=development

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:8000/api
